# --- Runtime ---
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001
LOG_LEVEL=info
SWAGGER_ENABLED=true
TRUST_PROXY=false

# --- TradeLoop operations ---
# Demo clock: operations time starts at the seed's "now" and advances 2 min per recorded event.
# Leave empty for real (Asia/Manila) time.
OPS_CLOCK_ANCHOR=2026-09-25T07:48
# Lets owners of demo organizations reset their data to the seed.
OPS_DEMO_RESET=true

# --- PostgreSQL (docker compose exposes 5433 on the host) ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=tradeloop
DB_PASSWORD=tradeloop
DB_NAME=tradeloop
DB_SSL=false
DB_LOGGING=false
DB_POOL_SIZE=10

# --- Redis (docker compose exposes 6380 on the host) ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_PREFIX=tradeloop

# --- Auth (REQUIRED: replace with a random 32+ char secret, e.g. `openssl rand -hex 32`) ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# --- Rate limiting ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=10

# --- Tracking ---
TRACKING_MIN_DISTANCE_M=25
TRACKING_MIN_INTERVAL_S=30
TRACKING_RETENTION_DAYS=0
TRACKING_DEFAULT_SPEED_KPH=40
TRACKING_ROAD_FACTOR=1.3

# --- Matching (weights are relative; they are normalised to 100) ---
MATCH_WEIGHT_ROUTE=30
MATCH_WEIGHT_VEHICLE=20
MATCH_WEIGHT_CAPACITY=15
MATCH_WEIGHT_SCHEDULE=15
MATCH_WEIGHT_PICKUP=10
MATCH_WEIGHT_DROPOFF=10
MATCH_MIN_SCORE=40
MATCH_CORRIDOR_KM=50
MATCH_PROXIMITY_RADIUS_KM=100
MATCH_SCHEDULE_TOLERANCE_HOURS=48

# --- Billing ---
PLATFORM_COMMISSION_TYPE=PERCENTAGE
PLATFORM_COMMISSION_VALUE=5
DEFAULT_CURRENCY=PHP

# --- Documents ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
UPLOAD_MAX_BYTES=10485760

# --- Development seed (never use in production) ---
SEED_PASSWORD=DevPassword123!
SEED_ADMIN_EMAIL=admin@tradeloop.local
